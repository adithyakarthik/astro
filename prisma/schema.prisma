// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("USER") // "USER" | "ADMIN"
  // Subscription tier, orthogonal to role — drives the default module bundle
  // an admin quick-selects for a user, but enabledModules remains the actual
  // source of truth for access (a tier change doesn't retroactively revoke).
  tier      String   @default("SILVER") // "SILVER" | "GOLD" | "PLATINUM"
  // JSON-encoded array of module keys this user's subscription has access
  // to, e.g. ["clients","matchmaking","muhurta","transits","videos","classes"].
  enabledModules String @default("[\"clients\",\"matchmaking\",\"muhurta\",\"transits\",\"videos\",\"classes\"]")
  createdAt DateTime @default(now())

  // Display/calculation preferences (Settings page).
  theme        String  @default("light") // "light" | "dark"
  chartStyle   String  @default("south") // "south" | "north" (Indian chart drawing styles)
  useTrueNodes Boolean @default(true) // Rahu/Ketu: true (instantaneous) node vs mean node

  clients      Client[]
  videos       VideoContent[]
  videoFolders VideoFolder[]
  classes      ClassAnnouncement[]
  sessions     Session[]
}

// One-time passcodes for email login. Not tied to a User row via foreign
// key because the very first OTP for a brand-new email is requested before
// any User exists yet (the User is created on first successful verify).
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid()) // also the value stored in the session cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Client-facing portal access (read-only view of their own kundlis),
  // granted/revoked by the astrologer — e.g. tied to a payment schedule.
  // Requires `email` to be set, since portal login is by OTP to that email.
  portalAccessEnabled   Boolean   @default(false)
  portalAccessExpiresAt DateTime? // null = no expiry while enabled

  // This client's subscription tier ("SILVER" | "GOLD" | "PLATINUM"), set by
  // the astrologer. Drives bulk video/folder access (grant a whole tier at
  // once) without needing to check every client individually; explicit
  // per-client VideoAccess/VideoFolderAccess grants remain available as a
  // manual override on top of whatever the tier already grants.
  tier String @default("SILVER")

  kundlis           Kundli[]
  portalSessions    ClientPortalSession[]
  videoFolderAccess VideoFolderAccess[]
  videoAccess       VideoAccess[]
}

model ClientPortalSession {
  id        String   @id @default(cuid()) // also the value stored in the portal session cookie
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Kundli {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  gender      String?
  // Birth details (source of truth for every recalculation)
  birthDate   DateTime // stored as UTC instant of birth
  birthPlace  String
  latitude    Float
  longitude   Float
  timezoneOffsetMinutes Int // minutes east of UTC at birth, e.g. IST = 330

  ayanamsa String @default("LAHIRI")

  // Computed chart data, cached as JSON so it doesn't need recomputing on every view.
  // Shape: { ascendantDeg, planets: [...], nakshatra, rasiChart, navamsaChart, dasha }
  chartData String

  // Free-text notes about this specific chart/client (analysis, remedies, session notes, etc).
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoContent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional folder for access-controlled grouping. A video is "public" (visible
  // to every one of this astrologer's portal clients) only when it has NO folder,
  // NO direct per-video grants, AND NO tier restriction below — assigning any of
  // these restricts it to whichever clients qualify, via folder access, a
  // matching subscription tier, a direct per-client grant, or any combination.
  folderId String?
  folder   VideoFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  access   VideoAccess[]
  // Subscription tiers ("SILVER"/"GOLD"/"PLATINUM") automatically granted
  // access to this video, independent of (and additive with) folder/direct access.
  allowedTiers String[] @default([])

  title       String
  description String?
  youtubeUrl  String
  youtubeId   String
  category    String? // e.g. "Kundli Basics", "Dasha", "Remedies"
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Per-video, per-client access grant — independent of (and additive with) any
// folder the video belongs to, for restricting a single video without needing
// a folder at all.
model VideoAccess {
  id       String       @id @default(cuid())
  videoId  String
  video    VideoContent @relation(fields: [videoId], references: [id], onDelete: Cascade)
  clientId String
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([videoId, clientId])
}

// A folder groups published videos and lets the astrologer restrict viewing
// to specific clients (e.g. by subscription tier) via VideoFolderAccess.
model VideoFolder {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())
  // Subscription tiers ("SILVER"/"GOLD"/"PLATINUM") automatically granted
  // access to every video in this folder, additive with per-client grants.
  allowedTiers String[] @default([])

  videos VideoContent[]
  access VideoFolderAccess[]
}

model VideoFolderAccess {
  id       String      @id @default(cuid())
  folderId String
  folder   VideoFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  clientId String
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([folderId, clientId])
}

model ClassAnnouncement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  startsAt    DateTime
  // Optional explicit end (date + time) for multi-day courses or sessions
  // that don't fit a single duration. When absent, durationMins is used.
  endsAt      DateTime?
  durationMins Int     @default(60)
  feeInRupees Float
  upiId       String
  payeeName   String
  meetingLink String?
  createdAt   DateTime @default(now())

  payments ClassPayment[]
}

model ClassPayment {
  id      String            @id @default(cuid())
  classId String
  class   ClassAnnouncement @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentName String
  contact     String?
  amountPaid  Float
  paidAt      DateTime
  notes       String?
  createdAt   DateTime @default(now())
}
