// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kundlis Kundli[]
}

model Kundli {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  gender      String?
  // Birth details (source of truth for every recalculation)
  birthDate   DateTime // stored as UTC instant of birth
  birthPlace  String
  latitude    Float
  longitude   Float
  timezoneOffsetMinutes Int // minutes east of UTC at birth, e.g. IST = 330

  ayanamsa String @default("LAHIRI")

  // Computed chart data, cached as JSON so it doesn't need recomputing on every view.
  // Shape: { ascendantDeg, planets: [...], nakshatra, rasiChart, navamsaChart, dasha }
  chartData String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoContent {
  id          String   @id @default(cuid())
  title       String
  description String?
  youtubeUrl  String
  youtubeId   String
  category    String? // e.g. "Kundli Basics", "Dasha", "Remedies"
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ClassAnnouncement {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  durationMins Int     @default(60)
  feeInRupees Float
  upiId       String
  payeeName   String
  meetingLink String?
  createdAt   DateTime @default(now())
}
