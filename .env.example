# Copy this file to .env and fill in your own values.

DATABASE_URL="file:./dev.db"

# Comma-separated emails that get ADMIN access (module management) the first
# time they log in. Anyone else who logs in gets a regular USER account.
ADMIN_EMAILS="you@example.com"

# Optional: set these to send real OTP login emails via Resend (resend.com,
# free tier available). Leave unset for local/dev use — the login code is
# shown directly on the verify page instead of being emailed.
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="login@yourdomain.com"
