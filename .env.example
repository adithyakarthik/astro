# Copy this file to .env and fill in your own values.

# A Postgres connection string. Get a free one from neon.tech, supabase.com,
# or Vercel's own Postgres storage add-on when you deploy.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Comma-separated emails that get ADMIN access (module management) the first
# time they log in. Anyone else who logs in gets a regular USER account.
ADMIN_EMAILS="you@example.com"

# Optional: set these to send real OTP login emails via Resend (resend.com,
# free tier available). Leave unset for local/dev use — the login code is
# shown directly on the verify page instead of being emailed.
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="login@yourdomain.com"

# Optional: set this to enable AI-generated chart predictions (Profession,
# Health, Family, etc.) on the kundli and Prashna pages. Get a key from
# console.anthropic.com. Leave unset to hide the feature behind a
# "not configured" message instead of erroring.
# ANTHROPIC_API_KEY="sk-ant-xxx"

# Optional: set this to store Finds photos in Vercel Blob storage (enable
# "Blob" under Storage in your Vercel project — it auto-fills this var when
# linked with `vercel env pull`). Leave unset for local/dev use — photos are
# saved to public/uploads/finds/ on disk instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
